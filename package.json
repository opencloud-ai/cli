{
  "name": "@opencloud/cli",
  "version": "3.0.1",
  "description": "Versioned command-line client for building, deploying, and verifying OpenCloud applications",
  "type": "module",
  "bin": {
    "opencloud": "./dist/index.cjs"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src vendor/contracts/src vendor/browser-client/src vendor/control-plane-client/src",
    "lint": "npm run typecheck",
    "verify:version": "node scripts/verify-version.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@napi-rs/keyring": "1.3.0"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/ws": "8.18.1",
    "commander": "15.0.0",
    "cron-parser": "5.6.2",
    "esbuild": "0.25.8",
    "tar": "7.5.22",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "ws": "8.21.1",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  }
}
